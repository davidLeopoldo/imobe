# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# credenciais / chaves (nunca commitar)
*.key
*.p12
*.pfx
id_rsa
id_ed25519
credentials.json
service-account.json
gcp-key.json
secrets.json
secrets.yaml

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# relatórios de auditoria de segurança (podem detalhar vulnerabilidades — não versionar)
security-reports/

# playwright mcp test artifacts
.playwright-mcp

# typescript
*.tsbuildinfo
next-env.d.ts
.playwright-mcp/
*:Zone.Identifier
